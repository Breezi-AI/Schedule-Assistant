# Railway injects DATABASE_URL automatically when you attach a Postgres service.
DATABASE_URL=postgres://user:pass@host:5432/railway

# Bearer token for POST /hooks/cc  (Claude Code hooks send this)
# Generate with: openssl rand -hex 24
ASSISTANT_TOKEN=replace-me

# Token the gym page uses. Can be the same value or different.
APP_TOKEN=replace-me

# Minutes of silence after which a Claude Code session is considered closed.
SESSION_GAP_MINUTES=30

TZ=America/New_York
